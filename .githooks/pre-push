#!/bin/sh
# Blocks direct pushes to main: changes go PR -> CI -> /code-review -> gh pr merge
# (docs/standards/deploy.md in notionsocial-backend). Allowed: pushes whose commits only touch
# DEPLOYMENTS.csv (deploy log), tag pushes, and ALLOW_MAIN_PUSH=1 for an emergency.
[ "$ALLOW_MAIN_PUSH" = "1" ] && exit 0
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  other=$(git diff --name-only "$range" 2>/dev/null | grep -v '^DEPLOYMENTS.csv$')
  if [ -n "$other" ]; then
    echo "pre-push: direct push to main blocked. Open a PR: git push -u origin <branch> && gh pr create" >&2
    echo "pre-push: files: $(echo "$other" | head -5 | tr '\n' ' ')" >&2
    exit 1
  fi
done
exit 0
